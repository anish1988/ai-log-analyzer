"use client";

import {
  
  ChevronDown,
  Loader2,
  Search,
} from "lucide-react";

import { useState } from "react";

import {
  SavedSearch,
  useSavedSearches,
} from "@/hooks/useSavedSearches";

interface SavedSearchesProps {
  onLoaded?: (savedSearch: SavedSearch) => void;
}

export default function SavedSearches({
  onLoaded,
}: SavedSearchesProps) {

  const {
    savedSearches,
    total,
    isLoading,
    isLoadingOne,
    error,
    loadSavedSearch,
  } = useSavedSearches();

  const [
    selectedId,
    setSelectedId,
  ] = useState<number | null>(null);

  const handleLoad = async (
    savedSearchId: number,
  ) => {

    setSelectedId(savedSearchId);

    const savedSearch =
      await loadSavedSearch(
        savedSearchId,
      );

    if (savedSearch) {
      onLoaded?.(savedSearch);
    }

    setSelectedId(null);
  };

  if (
    isLoading &&
    savedSearches.length === 0
  ) {
    return (
      <div className="rounded-xl border border-slate-200 bg-white p-5">
        <div className="flex items-center gap-2 text-sm text-slate-500">
          <Loader2 className="h-4 w-4 animate-spin" />
          Loading saved searches...
        </div>
      </div>
    );
  }

  return (
    <section className="rounded-xl border border-slate-200 bg-white">

      {/* HEADER */}

      <div className="flex items-center justify-between border-b border-slate-100 px-5 py-4">

        <div>

          <h2 className="text-base font-semibold text-slate-900">
            Saved Searches
          </h2>

          <p className="mt-1 text-xs text-slate-500">
            {total} saved{" "}
            {total === 1 ? "search" : "searches"}
          </p>

        </div>

        <Search className="h-5 w-5 text-slate-400" />

      </div>

      {/* ERROR */}

      {error && (
        <div className="mx-5 mt-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2.5 text-sm text-red-700">
          {error}
        </div>
      )}

      {/* EMPTY */}

      {!isLoading &&
        savedSearches.length === 0 &&
        !error && (

          <div className="px-5 py-8 text-center">

            <Search className="mx-auto h-8 w-8 text-slate-300" />

            <p className="mt-3 text-sm font-medium text-slate-600">
              No saved searches
            </p>

            <p className="mt-1 text-xs text-slate-400">
              Save your current filters to reuse them later.
            </p>

          </div>
        )}

      {/* LIST */}

      {savedSearches.length > 0 && (

        <div className="divide-y divide-slate-100">

          {savedSearches.map(
            (savedSearch) => (

              <div
                key={savedSearch.id}
                className="flex items-center justify-between gap-4 px-5 py-4 hover:bg-slate-50"
              >

                <div className="min-w-0">

                  <div className="flex items-center gap-2">

                    <p className="truncate text-sm font-medium text-slate-800">
                      {savedSearch.name}
                    </p>

                    <span className="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium capitalize text-slate-600">
                      {savedSearch.tier}
                    </span>

                  </div>

                  {savedSearch.description && (

                    <p className="mt-1 truncate text-xs text-slate-500">
                      {savedSearch.description}
                    </p>

                  )}

                  <p className="mt-1 text-xs text-slate-400">
                    {savedSearch.from}
                    {" → "}
                    {savedSearch.to}
                  </p>

                </div>

                <button
                  type="button"
                  onClick={() =>
                    handleLoad(savedSearch.id)
                  }
                  disabled={
                    isLoadingOne &&
                    selectedId === savedSearch.id
                  }
                  className="inline-flex shrink-0 items-center gap-2 rounded-lg border border-indigo-200 bg-white px-3 py-2 text-xs font-medium text-indigo-600 hover:bg-indigo-50 disabled:cursor-not-allowed disabled:opacity-60"
                >

                  {isLoadingOne &&
                  selectedId === savedSearch.id ? (

                    <Loader2 className="h-3.5 w-3.5 animate-spin" />

                  ) : (

                    <ChevronDown className="h-3.5 w-3.5" />

                  )}

                  Load

                </button>

              </div>
            ),
          )}

        </div>
      )}

    </section>
  );
}
